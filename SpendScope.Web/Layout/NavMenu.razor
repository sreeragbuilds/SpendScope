@* One list of links, laid out as top-bar tabs on wide screens and stacked in the drawer on narrow ones. *@
<nav aria-label="Main" class="@("nav-list " + Class)">
    <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
    <NavLink class="nav-item" href="/expenses" Match="NavLinkMatch.Prefix">Expenses</NavLink>
    <NavLink class="nav-item" href="/categories">Categories</NavLink>
    <NavLink class="nav-item" href="/profile">Profile</NavLink>

    @* Admin section only for the Admin role (spec 19.2). The API enforces this independently. *@
    <AuthorizeView Roles="Admin">
        <span class="nav-heading d-md-none">Admin</span>
        <NavLink class="nav-item" href="/admin/users">Users</NavLink>
        <NavLink class="nav-item" href="/admin/totals">Totals</NavLink>
    </AuthorizeView>
</nav>

@code {
    [Parameter] public string? Class { get; set; }
}
