@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState ThemeState
@inject AuthSession Session
@inject NavigationManager Navigation

<Providers />

<MudLayout @onkeydown="OnKeyDown">
    <MudAppBar Elevation="0" Class="app-bar" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="d-md-none"
                       OnClick="() => _drawerOpen = !_drawerOpen"
                       aria-label="@(_drawerOpen ? "Hide navigation" : "Show navigation")"
                       aria-expanded="@(_drawerOpen ? "true" : "false")"
                       aria-controls="app-navigation" />
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="app-brand">
            <MudIcon Icon="@Icons.Material.Filled.DonutLarge" aria-hidden="true" />
            <span>SpendScope</span>
        </MudLink>
        <NavMenu Class="d-none d-md-flex" />
        <MudSpacer />
        <MudTooltip Text="@(ThemeState.IsDark ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(ThemeState.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ThemeState.ToggleAsync"
                           aria-label="@(ThemeState.IsDark ? "Switch to light mode" : "Switch to dark mode")" />
        </MudTooltip>
        <AuthorizeView>
            <Authorized>
                <span class="app-user d-none d-sm-flex">@context.User.Identity?.Name</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Log out</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* Narrow screens only: wide screens use the tabs in the top bar. *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Temporary"
               Class="d-md-none" id="app-navigation">
        <NavMenu Class="stack" />
    </MudDrawer>

    <MudMainContent>
        <main id="main-content" tabindex="-1">
        <MudContainer MaxWidth="MaxWidth.Large" Class="app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">
                        Something went wrong on this page.
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => _errorBoundary?.Recover()">Try again</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _drawerOpen = false;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}
