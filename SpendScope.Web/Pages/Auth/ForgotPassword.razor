@page "/forgot-password"
@layout AuthLayout
@inject AccountApiClient Accounts

<PageTitle>Forgot password · SpendScope</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-1">Reset your password</MudText>

@if (_sent)
{
    <MudAlert Severity="Severity.Success" Class="my-4" role="status">
        If an account exists for that email, a reset link has been sent. Check your inbox.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Enter your email and we'll send you a reset link.</MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert>
    }
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
        <MudStack Spacing="4">
            <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" autocomplete="email" Immediate="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">Send reset link</MudButton>
        </MudStack>
    </form>
}

<MudText Typo="Typo.body2" Class="mt-6" Align="Align.Center"><MudLink Href="/login">Back to sign in</MudLink></MudText>

@code {
    private string _email = string.Empty;
    private bool _sent;
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        var result = await Accounts.ForgotPasswordAsync(_email.Trim());
        _busy = false;
        if (result.IsSuccess)
        {
            _sent = true;
        }
        else
        {
            _error = result.Status == 400 ? "Enter a valid email address." : ApiMessages.For(result);
        }
    }
}
