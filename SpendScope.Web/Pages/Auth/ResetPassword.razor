@page "/reset-password"
@layout AuthLayout
@inject AccountApiClient Accounts

<PageTitle>Choose a new password · SpendScope</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Choose a new password</MudText>

@if (_done)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" role="status">Your password was changed. All other sessions were signed out.</MudAlert>
    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Sign in</MudButton>
}
else if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
{
    <MudAlert Severity="Severity.Warning">This reset link is incomplete. Request a new one.</MudAlert>
    <MudText Typo="Typo.body2" Class="mt-4"><MudLink Href="/forgot-password">Request a new link</MudLink></MudText>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert>
    }
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
        <MudStack Spacing="4">
            <MudTextField Value="Email" Label="Email" ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_password" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined"
                          autocomplete="new-password" Immediate="true"
                          HelperText="At least 10 characters with upper and lower case letters, a digit and a symbol." />
            <MudTextField @bind-Value="_confirm" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined"
                          autocomplete="new-password" Immediate="true"
                          Error="@(_confirm.Length > 0 && _confirm != _password)" ErrorText="Passwords don't match." />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@(_busy || !PasswordPolicy.IsSatisfied(_password) || _password != _confirm)">Change password</MudButton>
        </MudStack>
    </form>
}

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;
    private bool _done;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        var result = await Accounts.ResetPasswordAsync(new ResetPasswordRequest(Email!, Token!, _password));
        _busy = false;

        if (result.IsSuccess)
        {
            _done = true;
            return;
        }

        _error = result.HasCode("invalid_token")
            ? "This reset link is invalid or has expired. Request a new one."
            : result.FieldError("newPassword") ?? ApiMessages.For(result);
    }
}
